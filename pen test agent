<title>Strix — Live Architecture</title>
<style>
  :root{
    --bg:#0d1119; --grid:#151d2b;
    --surface:#141b26; --surface-2:#1b2432; --surface-3:#212c3e;
    --line:#2a3547; --line-strong:#3a4860;
    --ink:#e8edf5; --muted:#8593a8; --faint:#5b6a82;
    --accent:#34d8c6; --accent-ink:#052b27;
    --docker:#4c9bff; --llm:#b48bff; --danger:#ff5f6e; --ok:#4bd48a;
    --mono: ui-monospace, "SF Mono", "JetBrains Mono", "Cascadia Code", Menlo, Consolas, monospace;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --shadow: 0 18px 50px -22px rgba(0,0,0,.75);
    --r:14px;
  }
  @media (prefers-color-scheme: light){
    :root{
      --bg:#eaeef5; --grid:#dbe2ee;
      --surface:#ffffff; --surface-2:#f3f6fb; --surface-3:#e9eef7;
      --line:#d5dde9; --line-strong:#c0cad9;
      --ink:#16202e; --muted:#5a6880; --faint:#8b98ac;
      --accent:#0aa593; --accent-ink:#e6fffb;
      --docker:#2b7fff; --llm:#7a4dff; --danger:#dc2f40; --ok:#12a05f;
      --shadow: 0 18px 46px -26px rgba(31,45,70,.45);
    }
  }
  :root[data-theme="dark"]{
    --bg:#0d1119; --grid:#151d2b; --surface:#141b26; --surface-2:#1b2432; --surface-3:#212c3e;
    --line:#2a3547; --line-strong:#3a4860; --ink:#e8edf5; --muted:#8593a8; --faint:#5b6a82;
    --accent:#34d8c6; --accent-ink:#052b27; --docker:#4c9bff; --llm:#b48bff; --danger:#ff5f6e; --ok:#4bd48a;
    --shadow: 0 18px 50px -22px rgba(0,0,0,.75);
  }
  :root[data-theme="light"]{
    --bg:#eaeef5; --grid:#dbe2ee; --surface:#ffffff; --surface-2:#f3f6fb; --surface-3:#e9eef7;
    --line:#d5dde9; --line-strong:#c0cad9; --ink:#16202e; --muted:#5a6880; --faint:#8b98ac;
    --accent:#0aa593; --accent-ink:#e6fffb; --docker:#2b7fff; --llm:#7a4dff; --danger:#dc2f40; --ok:#12a05f;
    --shadow: 0 18px 46px -26px rgba(31,45,70,.45);
  }

  *{box-sizing:border-box}
  html,body{margin:0}
  body{
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0/ 46px 46px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0/ 46px 46px,
      var(--bg);
    color:var(--ink); font-family:var(--sans); line-height:1.5;
    -webkit-font-smoothing:antialiased; padding:clamp(14px,3vw,34px);
  }
  .wrap{max-width:1160px; margin:0 auto; display:flex; flex-direction:column; gap:18px}

  /* ---------- header ---------- */
  header.top{display:flex; align-items:flex-end; justify-content:space-between; gap:18px; flex-wrap:wrap}
  .brand{display:flex; flex-direction:column; gap:8px}
  .eyebrow{font-family:var(--mono); font-size:.68rem; letter-spacing:.24em; text-transform:uppercase; color:var(--accent)}
  h1{font-family:var(--mono); font-weight:600; font-size:clamp(1.5rem,3.4vw,2.15rem); margin:0; letter-spacing:-.01em; text-wrap:balance}
  h1 .dim{color:var(--faint)}
  .sub{color:var(--muted); font-size:.95rem; max-width:56ch}
  .theme-btn{
    font-family:var(--mono); font-size:.72rem; letter-spacing:.06em; color:var(--muted);
    background:var(--surface); border:1px solid var(--line); border-radius:999px;
    padding:9px 14px; cursor:pointer; display:inline-flex; gap:8px; align-items:center; transition:.18s;
  }
  .theme-btn:hover{color:var(--ink); border-color:var(--line-strong)}
  .theme-btn:focus-visible{outline:2px solid var(--accent); outline-offset:2px}

  /* ---------- stage ---------- */
  .stage{
    position:relative; background:var(--surface); border:1px solid var(--line);
    border-radius:var(--r); box-shadow:var(--shadow); padding:20px;
    display:grid; grid-template-columns: 1.35fr 1.5fr 0.9fr; gap:16px; min-height:430px;
    overflow:hidden;
  }
  @media (max-width:820px){ .stage{grid-template-columns:1fr; min-height:0} }

  .zone{
    position:relative; border:1px solid var(--line); border-radius:12px;
    background:var(--surface-2); padding:14px; display:flex; flex-direction:column; gap:12px;
    transition:border-color .35s, box-shadow .35s, opacity .5s, filter .5s;
  }
  .zone[data-live="1"]{border-color:var(--line-strong)}
  .zone-hd{display:flex; align-items:center; gap:9px}
  .dot{width:8px; height:8px; border-radius:50%; background:var(--faint); transition:.35s; flex:none; box-shadow:0 0 0 0 transparent}
  .zone[data-live="1"] .dot{background:var(--zone); box-shadow:0 0 0 4px color-mix(in oklab, var(--zone) 22%, transparent)}
  .zone-title{font-family:var(--mono); font-size:.74rem; letter-spacing:.12em; text-transform:uppercase; color:var(--ink)}
  .zone-note{font-family:var(--mono); font-size:.62rem; color:var(--faint); margin-left:auto; letter-spacing:.04em}

  .zone--host{--zone:var(--accent)}
  .zone--docker{--zone:var(--docker)}
  .zone--llm{--zone:var(--llm)}

  /* CLI */
  .cli{
    font-family:var(--mono); font-size:.76rem; background:var(--bg); border:1px solid var(--line);
    border-radius:8px; padding:9px 11px; color:var(--muted); white-space:nowrap; overflow:hidden;
  }
  .cli .prompt{color:var(--accent)}
  .cli .cmd{color:var(--ink)}
  .cli .caret{display:inline-block; width:7px; height:1.05em; background:var(--accent); vertical-align:-2px; margin-left:2px; animation:blink 1s steps(1) infinite}
  @keyframes blink{50%{opacity:0}}

  .node{
    border:1px solid var(--line); border-radius:9px; background:var(--surface-3);
    padding:9px 11px; display:flex; align-items:center; gap:10px; transition:.35s; position:relative;
  }
  .node .id{font-family:var(--mono); font-size:.6rem; color:var(--faint); margin-left:auto; letter-spacing:.03em}
  .node .name{font-size:.82rem; font-weight:600}
  .node .glyph{width:22px; height:22px; border-radius:6px; display:grid; place-items:center; font-family:var(--mono); font-size:.7rem; flex:none;
    background:color-mix(in oklab, var(--zone,var(--accent)) 20%, transparent); color:var(--zone,var(--accent))}
  .node[data-state="running"]{border-color:var(--accent); box-shadow:0 0 0 1px color-mix(in oklab,var(--accent) 40%, transparent)}
  .node[data-state="waiting"]{opacity:.62}
  .node[data-state="waiting"] .name::after{content:" · waiting"; color:var(--faint); font-weight:400; font-size:.72rem}
  .node[data-state="done"]{border-color:color-mix(in oklab,var(--ok) 55%, var(--line))}
  .node .check{color:var(--ok); font-weight:700; opacity:0; transition:.3s}
  .node[data-state="done"] .check{opacity:1}

  .graph{display:flex; flex-direction:column; gap:8px}
  .children{display:flex; flex-direction:column; gap:8px; margin-left:16px; position:relative}
  .children::before{content:""; position:absolute; left:-8px; top:-4px; bottom:14px; width:1px; background:var(--line-strong)}
  .child{opacity:0; transform:translateY(-6px) scale(.96); transition:opacity .45s, transform .45s}
  .child[data-shown="1"]{opacity:1; transform:none}

  .coordinator{
    font-family:var(--mono); font-size:.66rem; letter-spacing:.03em; color:var(--muted);
    border:1px dashed var(--line-strong); border-radius:8px; padding:8px 10px; display:flex; gap:8px; align-items:center;
    transition:.35s;
  }
  .coordinator[data-live="1"]{color:var(--ink); border-color:var(--accent); border-style:solid}
  .coordinator .pill{margin-left:auto; font-size:.58rem; padding:2px 7px; border-radius:999px; background:var(--surface-3); color:var(--faint)}
  .coordinator[data-live="1"] .pill{background:color-mix(in oklab,var(--accent) 22%, transparent); color:var(--accent)}

  /* docker inner */
  .ws{font-family:var(--mono); font-size:.66rem; color:var(--muted); border:1px solid var(--line); border-radius:8px; padding:8px 10px; display:flex; align-items:center; gap:8px}
  .ws b{color:var(--ink); font-weight:600}
  .tools{display:flex; flex-wrap:wrap; gap:7px}
  .chip{
    font-family:var(--mono); font-size:.66rem; padding:5px 9px; border-radius:7px; border:1px solid var(--line);
    background:var(--surface-3); color:var(--muted); transition:.28s; position:relative;
  }
  .chip[data-fire="1"]{color:var(--docker); border-color:var(--docker); box-shadow:0 0 0 3px color-mix(in oklab,var(--docker) 18%, transparent); transform:translateY(-1px)}
  .chip.proxy[data-on="1"]{color:var(--accent); border-color:var(--accent)}
  .caps{font-family:var(--mono); font-size:.58rem; color:var(--faint); letter-spacing:.03em}

  .vuln{
    margin-top:auto; border:1px solid var(--danger); border-radius:9px; overflow:hidden;
    background:color-mix(in oklab, var(--danger) 12%, var(--surface-2));
    opacity:0; transform:translateY(8px); transition:opacity .5s, transform .5s; max-height:0;
  }
  .vuln[data-shown="1"]{opacity:1; transform:none; max-height:120px}
  .vuln .vh{display:flex; align-items:center; gap:8px; padding:8px 10px; font-family:var(--mono); font-size:.66rem; color:var(--danger); letter-spacing:.05em; text-transform:uppercase; border-bottom:1px solid color-mix(in oklab,var(--danger) 30%, transparent)}
  .vuln .vb{padding:8px 10px; font-size:.78rem}
  .sev{margin-left:auto; font-size:.58rem; background:var(--danger); color:#fff; padding:2px 7px; border-radius:999px}

  .status{font-family:var(--mono); font-size:.62rem; letter-spacing:.05em; color:var(--faint)}
  .zone--docker[data-phase="boot"] .status{color:var(--docker)}
  .zone--docker[data-phase="run"] .status{color:var(--ok)}
  .zone--docker[data-phase="dead"]{opacity:.4; filter:grayscale(.6)}
  .zone--docker[data-phase="dead"] .status{color:var(--danger)}
  .zone--docker[data-phase="off"]{opacity:.5}

  /* llm */
  .brain{
    flex:1; min-height:120px; border:1px solid var(--line); border-radius:10px; display:grid; place-items:center;
    background:radial-gradient(120% 120% at 50% 30%, color-mix(in oklab,var(--llm) 10%, transparent), transparent 60%);
    position:relative; overflow:hidden;
  }
  .brain .core{width:56px; height:56px; border-radius:50%; background:color-mix(in oklab,var(--llm) 22%, transparent);
    border:1px solid color-mix(in oklab,var(--llm) 55%, transparent); display:grid; place-items:center; color:var(--llm);
    font-family:var(--mono); font-size:.6rem; transition:.3s}
  .brain[data-think="1"] .core{box-shadow:0 0 0 0 color-mix(in oklab,var(--llm) 45%, transparent); animation:think 1.1s ease-out infinite}
  @keyframes think{0%{box-shadow:0 0 0 0 color-mix(in oklab,var(--llm) 40%, transparent)} 100%{box-shadow:0 0 0 26px transparent}}
  .llm-meta{font-family:var(--mono); font-size:.6rem; color:var(--faint); text-align:center; line-height:1.6}
  .llm-meta b{color:var(--llm)}
  .results{
    font-family:var(--mono); font-size:.64rem; color:var(--ok); border:1px solid color-mix(in oklab,var(--ok) 45%, var(--line));
    border-radius:8px; padding:8px 10px; opacity:0; transform:translateY(6px); transition:.45s; display:flex; gap:8px; align-items:center;
  }
  .results[data-shown="1"]{opacity:1; transform:none}

  /* tokens */
  .token{
    position:absolute; top:0; left:0; z-index:20; pointer-events:none;
    font-family:var(--mono); font-size:.62rem; letter-spacing:.02em; white-space:nowrap;
    padding:4px 9px; border-radius:999px; opacity:0;
    background:var(--surface-3); border:1px solid var(--line-strong); color:var(--ink);
    box-shadow:0 6px 18px -8px rgba(0,0,0,.6);
    transition: transform .72s cubic-bezier(.5,0,.2,1), opacity .3s;
  }
  .token::before{content:""; position:absolute; inset:-1px; border-radius:inherit; opacity:.0}
  .token--cmd{border-color:var(--docker); color:var(--docker)}
  .token--llm{border-color:var(--llm); color:var(--llm)}
  .token--msg{border-color:var(--accent); color:var(--accent)}
  .token--spawn{border-color:var(--accent); color:var(--accent)}
  .token--danger{border-color:var(--danger); color:var(--danger)}

  .pulse{animation:pulse .6s ease-out}
  @keyframes pulse{0%{box-shadow:0 0 0 0 color-mix(in oklab,var(--accent) 45%, transparent)}100%{box-shadow:0 0 0 14px transparent}}

  .decision{
    font-family:var(--mono); font-size:.62rem; border:1px solid var(--line); border-radius:8px;
    padding:8px 10px; display:flex; flex-direction:column; gap:3px; transition:.3s; background:var(--surface);
  }
  .decision[data-active="1"]{border-color:var(--llm); box-shadow:0 0 0 3px color-mix(in oklab,var(--llm) 15%, transparent)}
  .decision .dl{font-size:.54rem; letter-spacing:.14em; text-transform:uppercase; color:var(--faint)}
  .decision[data-active="1"] .dl{color:var(--llm)}
  .decision .dv{color:var(--muted); line-height:1.4}
  .decision[data-active="1"] .dv{color:var(--ink)}

  /* ---------- LLM role explainer ---------- */
  .role{
    background:var(--surface); border:1px solid var(--line); border-radius:var(--r); box-shadow:var(--shadow);
    padding:18px 20px; display:flex; flex-direction:column; gap:16px;
  }
  .role-hd{display:flex; align-items:baseline; gap:12px; flex-wrap:wrap}
  .role-hd .k{font-family:var(--mono); font-size:.7rem; letter-spacing:.2em; text-transform:uppercase; color:var(--llm)}
  .role-hd h2{font-family:var(--mono); font-weight:600; font-size:1.02rem; margin:0; letter-spacing:-.01em}
  .role-hd .lede{color:var(--muted); font-size:.9rem; margin-left:auto; max-width:46ch; text-align:right}
  @media (max-width:640px){ .role-hd .lede{margin-left:0; text-align:left} }

  .role-loop{
    font-family:var(--mono); font-size:.72rem; color:var(--muted); background:var(--surface-2);
    border:1px solid var(--line); border-radius:10px; padding:12px 14px; overflow-x:auto;
    display:flex; align-items:center; gap:10px; white-space:nowrap;
  }
  .role-loop .b{color:var(--ink)}
  .role-loop .arw{color:var(--llm)}
  .role-loop .lc{color:var(--llm)}
  .role-loop .cyc{color:var(--faint)}

  .split{display:grid; grid-template-columns:1fr 1fr; gap:14px}
  @media (max-width:640px){ .split{grid-template-columns:1fr} }
  .col{border:1px solid var(--line); border-radius:10px; padding:13px 14px; background:var(--surface-2); display:flex; flex-direction:column; gap:9px}
  .col h3{font-family:var(--mono); font-size:.72rem; letter-spacing:.06em; margin:0; display:flex; align-items:center; gap:8px}
  .col--think h3{color:var(--llm)}
  .col--do h3{color:var(--docker)}
  .col--code h3{color:var(--accent)}
  .col h3 .tag{width:8px; height:8px; border-radius:50%; flex:none}
  .col--think h3 .tag{background:var(--llm)}
  .col--do h3 .tag{background:var(--docker)}
  .col--code h3 .tag{background:var(--accent)}
  .col ul{margin:0; padding:0; list-style:none; display:flex; flex-direction:column; gap:7px}
  .col li{font-size:.86rem; color:var(--muted); padding-left:16px; position:relative; line-height:1.4}
  .col li::before{content:"›"; position:absolute; left:0; color:var(--faint)}
  .col li b{color:var(--ink); font-weight:600}
  .col li code{font-family:var(--mono); font-size:.82em; background:var(--surface); border:1px solid var(--line); border-radius:5px; padding:1px 5px; color:var(--ink)}

  .role-note{font-size:.88rem; color:var(--muted); line-height:1.55; margin:0}
  .role-note b{color:var(--ink); font-weight:600}
  .role-note code{font-family:var(--mono); font-size:.86em; color:var(--ink); background:var(--surface-2); border:1px solid var(--line); border-radius:5px; padding:1px 5px}

  /* ---------- narration ---------- */
  .panel{
    display:grid; grid-template-columns: 1fr; gap:14px; background:var(--surface); border:1px solid var(--line);
    border-radius:var(--r); padding:18px 20px; box-shadow:var(--shadow);
  }
  .panel-hd{display:flex; align-items:center; gap:12px; flex-wrap:wrap}
  .stepno{font-family:var(--mono); font-size:.72rem; color:var(--accent); letter-spacing:.08em; background:color-mix(in oklab,var(--accent) 14%, transparent); padding:4px 10px; border-radius:999px}
  .step-title{font-family:var(--mono); font-weight:600; font-size:1.02rem; letter-spacing:-.01em}
  .ref{margin-left:auto; font-family:var(--mono); font-size:.68rem; color:var(--muted); border:1px solid var(--line); border-radius:7px; padding:4px 9px; white-space:nowrap}
  .ref b{color:var(--ink); font-weight:600}
  .narration{color:var(--muted); font-size:.98rem; max-width:74ch; margin:0}
  .narration em{color:var(--ink); font-style:normal; font-weight:600}
  .narration code{font-family:var(--mono); font-size:.86em; background:var(--surface-2); border:1px solid var(--line); border-radius:5px; padding:1px 5px; color:var(--ink)}

  /* ---------- transport ---------- */
  .transport{display:flex; align-items:center; gap:10px; flex-wrap:wrap}
  .btn{
    font-family:var(--mono); font-size:.76rem; letter-spacing:.04em; cursor:pointer;
    background:var(--surface-2); border:1px solid var(--line); color:var(--ink); border-radius:9px;
    padding:9px 14px; transition:.16s; display:inline-flex; gap:8px; align-items:center;
  }
  .btn:hover{border-color:var(--line-strong); background:var(--surface-3)}
  .btn:focus-visible{outline:2px solid var(--accent); outline-offset:2px}
  .btn--primary{background:var(--accent); color:var(--accent-ink); border-color:transparent; font-weight:600}
  .btn--primary:hover{background:color-mix(in oklab,var(--accent) 88%, #000)}
  .spd{display:inline-flex; align-items:center; gap:6px; margin-left:auto; font-family:var(--mono); font-size:.7rem; color:var(--muted)}
  .spd .seg{display:inline-flex; border:1px solid var(--line); border-radius:8px; overflow:hidden}
  .spd button{font-family:var(--mono); font-size:.7rem; background:transparent; color:var(--muted); border:0; padding:6px 10px; cursor:pointer; transition:.15s}
  .spd button[aria-pressed="true"]{background:var(--accent); color:var(--accent-ink)}
  .spd button:focus-visible{outline:2px solid var(--accent); outline-offset:-2px}

  .track{display:flex; gap:6px; margin-top:2px}
  .tick{flex:1; height:6px; border-radius:999px; background:var(--surface-3); border:1px solid var(--line); cursor:pointer; padding:0; transition:.2s}
  .tick[data-on="1"]{background:var(--accent); border-color:var(--accent)}
  .tick[data-cur="1"]{box-shadow:0 0 0 2px color-mix(in oklab,var(--accent) 40%, transparent)}
  .tick:focus-visible{outline:2px solid var(--accent); outline-offset:2px}

  .legend{display:flex; gap:16px; flex-wrap:wrap; font-family:var(--mono); font-size:.64rem; color:var(--muted)}
  .legend span{display:inline-flex; align-items:center; gap:6px}
  .swatch{width:10px; height:10px; border-radius:3px; border:1px solid var(--line-strong)}

  .foot{font-family:var(--mono); font-size:.62rem; color:var(--faint); text-align:center; letter-spacing:.03em}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:.001ms !important; transition-duration:.12s !important}
    .cli .caret{animation:none}
  }
</style>

<div class="wrap">
  <header class="top">
    <div class="brand">
      <div class="eyebrow">Autonomous pentest engine · live schematic</div>
      <h1>How Strix runs <span class="dim">— from command to kill-chain</span></h1>
      <p class="sub">Watch one scan boot up: the sandbox spins, a root agent forks a swarm of specialists, they run real tools inside a shared Docker container, and findings flow back — step by step, in motion.</p>
    </div>
    <button class="theme-btn" id="themeBtn" aria-label="Toggle color theme">◐ <span id="themeLbl">Theme</span></button>
  </header>

  <!-- STAGE -->
  <section class="stage" id="stage" aria-label="Architecture animation stage">
    <!-- HOST -->
    <div class="zone zone--host" data-live="1" id="z-host">
      <div class="zone-hd"><span class="dot"></span><span class="zone-title">Your Mac</span><span class="zone-note">host</span></div>
      <div class="cli" id="cli"><span class="prompt">$</span> <span class="cmd" id="cliCmd"></span><span class="caret" id="caret"></span></div>
      <div class="coordinator" id="coord">AgentCoordinator <span class="pill" id="coordPill">idle</span></div>
      <div class="graph">
        <div class="node" id="rootNode" data-state="off" style="--zone:var(--accent); opacity:0; transition:opacity .4s">
          <span class="glyph">S</span><span class="name">strix</span><span class="check">✓</span><span class="id">root · a1b2</span>
        </div>
        <div class="children">
          <div class="node child" id="childA" data-shown="0" data-state="running" style="--zone:var(--accent)">
            <span class="glyph">A</span><span class="name">Auth Specialist</span><span class="check">✓</span><span class="id">a3f9c1d2</span>
          </div>
          <div class="node child" id="childB" data-shown="0" data-state="running" style="--zone:var(--accent)">
            <span class="glyph">P</span><span class="name">API Specialist</span><span class="check">✓</span><span class="id">b7e20915</span>
          </div>
        </div>
      </div>
    </div>

    <!-- DOCKER -->
    <div class="zone zone--docker" data-live="0" data-phase="off" id="z-docker">
      <div class="zone-hd"><span class="dot"></span><span class="zone-title">Docker Sandbox</span><span class="zone-note">one container / scan</span></div>
      <div class="ws"><b>/workspace</b> · target mounted</div>
      <div class="caps" id="caps">caps: NET_ADMIN · NET_RAW · host-gateway · tail -f /dev/null</div>
      <div class="tools" id="tools">
        <span class="chip" data-tool="nmap">nmap</span>
        <span class="chip" data-tool="ffuf">ffuf</span>
        <span class="chip" data-tool="sqlmap">sqlmap</span>
        <span class="chip" data-tool="nuclei">nuclei</span>
        <span class="chip proxy" data-tool="caido" data-on="0">caido&nbsp;proxy</span>
      </div>
      <div class="vuln" id="vuln" data-shown="0">
        <div class="vh">Vulnerability confirmed <span class="sev">HIGH</span></div>
        <div class="vb">IDOR on <code>/api/orders/{id}</code> — PoC validated</div>
      </div>
      <div class="status" id="dockerStatus">container: not started</div>
    </div>

    <!-- LLM -->
    <div class="zone zone--llm" data-live="0" id="z-llm">
      <div class="zone-hd"><span class="dot"></span><span class="zone-title">LLM Provider</span><span class="zone-note">the brain</span></div>
      <div class="brain" id="brain" data-think="0"><div class="core">LLM</div></div>
      <div class="llm-meta">decides <b>what</b> to do —<br>never touches the target</div>
      <div class="decision" id="decision" data-active="0"><span class="dl">decision</span><span class="dv" id="decisionVal">awaiting first turn</span></div>
      <div class="results" id="results" data-shown="0">↳ strix_runs/&lt;run&gt;/</div>
    </div>
  </section>

  <!-- NARRATION -->
  <section class="panel">
    <div class="panel-hd">
      <span class="stepno" id="stepno">01 / 14</span>
      <span class="step-title" id="stepTitle">—</span>
      <span class="ref" id="ref">—</span>
    </div>
    <p class="narration" id="narration">—</p>

    <div class="transport">
      <button class="btn btn--primary" id="playBtn">▶ Play</button>
      <button class="btn" id="stepBtn">⏭ Step</button>
      <button class="btn" id="restartBtn">↺ Restart</button>
      <div class="spd">speed
        <span class="seg" role="group" aria-label="Playback speed">
          <button data-spd="0.6" aria-pressed="false">0.6×</button>
          <button data-spd="1" aria-pressed="true">1×</button>
          <button data-spd="1.8" aria-pressed="false">1.8×</button>
        </span>
      </div>
    </div>

    <div class="track" id="track" role="group" aria-label="Jump to step"></div>

    <div class="legend">
      <span><span class="swatch" style="background:var(--accent)"></span>data / agent flow</span>
      <span><span class="swatch" style="background:var(--docker)"></span>Docker sandbox</span>
      <span><span class="swatch" style="background:var(--llm)"></span>LLM reasoning</span>
      <span><span class="swatch" style="background:var(--danger)"></span>vulnerability</span>
    </div>
  </section>

  <!-- LLM ROLE -->
  <section class="role" aria-label="The role of the LLM">
    <div class="role-hd">
      <span class="k">Under the hood</span>
      <h2>Who does what</h2>
      <p class="lede">Three layers: the <em>LLM</em> is the brain that decides, the <em>Python harness</em> is the nervous system that wires everything together, and the <em>Docker sandbox</em> is the hands.</p>
    </div>

    <div class="role-loop" aria-label="The agent loop around the LLM">
      <span class="lc">LLM</span><span class="arw">→</span>
      <span class="b">picks next action</span><span class="arw">→</span>
      <span class="b">tool runs in sandbox</span><span class="arw">→</span>
      <span class="b">output fed back</span><span class="arw">→</span>
      <span class="cyc">↺ repeat until</span> <span class="b">finish_scan</span>
    </div>

    <div class="split">
      <div class="col col--think">
        <h3><span class="tag"></span>What the LLM actually does</h3>
        <ul>
          <li><b>Strategy</b> — plan the attack; whether to split into a swarm (<code>create_agent</code>)</li>
          <li><b>Tool choice</b> — which tool + arguments (<code>nmap</code>, <code>sqlmap</code>, <code>ffuf</code>…)</li>
          <li><b>Interpretation</b> — read raw output, decide what it means</li>
          <li><b>Judgment</b> — is this a <b>real, validated</b> vuln worth filing?</li>
          <li><b>When to stop</b> — <code>finish_scan</code> / <code>agent_finish</code></li>
        </ul>
      </div>
      <div class="col col--code">
        <h3><span class="tag"></span>What the Python code does</h3>
        <ul>
          <li><b>Runs the loop</b> — calls the LLM, dispatches each tool call, feeds the result back (<code>execution.py</code>)</li>
          <li><b>Manages the sandbox</b> — boots &amp; tears down the container (<code>session_manager</code>, <code>docker_client</code>)</li>
          <li><b>Coordinates agents</b> — graph state, messages, park/wake, resume snapshots (<code>AgentCoordinator</code>)</li>
          <li><b>Spawns the swarm</b> — one <code>asyncio.create_task</code> per child</li>
          <li><b>Defines the tools</b> the model may call (<code>strix/tools/*</code>)</li>
          <li><b>Persists everything</b> — findings, <code>run.json</code>, <code>agents.db</code></li>
        </ul>
      </div>
    </div>

    <p class="role-note">The LLM never runs a command or opens a socket — the <b>Python harness</b> does, inside the <b>Docker sandbox</b>. The model only ever emits decisions; every violet pulse above is one. That clean split is what makes Strix debuggable: you can trace any action from a <b>model call</b>, to the <b>Python that dispatched it</b>, to the <b>container where it ran</b>.</p>
  </section>

  <!-- HOW IT ACTUALLY WORKS -->
  <section class="role" aria-label="How the testing phases actually work">
    <div class="role-hd">
      <span class="k">How it actually works</span>
      <h2>Are the phases coded, or decided by the LLM?</h2>
      <p class="lede">The phases (Recon → Auth → XSS → CSRF → Endpoint discovery) are <em>defined by the LLM, not by Python</em>. There is no state machine that runs "Phase 1 → Phase 2 → …".</p>
    </div>

    <p class="role-note">Python sets up the agent loop, the tools, and injects <b>Markdown guidance</b> into the model's context. The LLM reads that guidance and decides its own workflow. The exact 5 phases you listed are <b>emergent</b> — what the model chose to do on one specific run. They aren't written anywhere as a fixed pipeline.</p>

    <div class="split">
      <div class="col col--think">
        <h3><span class="tag"></span>Methodology lives in Markdown</h3>
        <ul>
          <li><b>Scan modes</b> hold the closest thing to "phases" — as prose, not code branches: <code>scan_modes/standard.md</code>, <code>quick.md</code>, <code>deep.md</code></li>
          <li>Standard mode suggests: Recon → Business Logic → Systematic Testing → Exploitation → Reporting</li>
          <li>Your Auth/XSS/CSRF/endpoint split doesn't match any file exactly — the model <b>synthesized</b> it from this guidance plus the target</li>
          <li><code>load_skill</code> lets the model <b>pull in</b> skill files on demand (e.g. <code>["xss","csrf"]</code>) as reference</li>
          <li><code>coordination/root_agent.md</code> tells the root to decompose the target and spawn subagents dynamically</li>
        </ul>
      </div>
      <div class="col col--code">
        <h3><span class="tag"></span>Python's role is orchestration</h3>
        <ul>
          <li><b>The prompt</b> — <code>agents/prompts/system_prompt.jinja</code>, a template filled with scope/authorization</li>
          <li><b>The loop</b> — calls the LLM, dispatches each tool call, feeds results back (<code>execution.py</code>)</li>
          <li><b>The sandbox</b> — boots &amp; tears down the container (<code>session_manager</code>, <code>docker_client</code>)</li>
          <li><b>The tools</b> the model may call (<code>strix/tools/*</code>)</li>
          <li>Nothing here enforces phase <b>order</b> — that's the model's choice, turn by turn</li>
        </ul>
      </div>
    </div>

    <p class="role-note">The flow is: Python starts an LLM agent → the LLM reads scan-mode + skill guidance → it plans phases and spawns subagents → each subagent loads relevant vulnerability skills and tests. <b>The "phases" are a reasoning artifact of the model.</b> To force a fixed sequence, you'd edit the scan-mode Markdown or add orchestration code — right now nothing in Python guarantees any particular phase order.</p>

    <div class="split">
      <div class="col col--code">
        <h3><span class="tag"></span>What it can find — 23 vulnerability playbooks</h3>
        <ul>
          <li><b>Injection</b> — sql_injection, nosql_injection, rce, ssti, xxe, header_injection</li>
          <li><b>Client-side</b> — xss, csrf, open_redirect, prototype_pollution</li>
          <li><b>Access control</b> — idor, broken_function_level_authorization, mass_assignment, business_logic</li>
          <li><b>Auth / session</b> — authentication_jwt</li>
          <li><b>Server-side</b> — ssrf, insecure_deserialization, path_traversal_lfi_rfi, http_request_smuggling, race_conditions</li>
          <li><b>Exposure</b> — information_disclosure, insecure_file_uploads, subdomain_takeover</li>
        </ul>
      </div>
      <div class="col col--think">
        <h3><span class="tag"></span>These are guides, not code</h3>
        <ul>
          <li>Each lives at <code>strix/skills/vulnerabilities/&lt;name&gt;.md</code> — a technique reference the model loads as needed</li>
          <li>The model applies them using <b>real tools</b> under <code>strix/skills/tooling/</code></li>
          <li>Proxy, browser, shell, plus <code>nmap</code>, <code>nuclei</code>, <code>sqlmap</code>, <code>ffuf</code>, <code>semgrep</code>…</li>
          <li><b>Bottom line:</b> phase selection <em>and</em> vulnerability selection are LLM-driven, adaptive, and guided by editable Markdown</li>
        </ul>
      </div>
    </div>
  </section>

  <p class="foot">A teaching visualization of the Strix scan lifecycle · step references point at the real source</p>
</div>

<script>
(function(){
  "use strict";
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var $ = function(s){ return document.querySelector(s); };
  var stage = $("#stage");

  var CMD = "strix --target https://shop.example.com -n";

  // ---- step definitions (narration + real file:line) ----
  var STEPS = [
    { t:"Command invoked",
      r:"main.py:740",
      h:"You run <code>strix --target … -n</code>. <em>main()</em> parses the target, picks non-interactive mode, and begins preflight. Nothing is running yet — this is just your Mac." },
    { t:"Pull the sandbox image",
      r:"main.py:690",
      h:"Strix checks Docker, then <em>pulls the sandbox image</em> <code>ghcr.io/usestrix/strix-sandbox</code> — a Kali Linux box with the whole pentest toolkit baked in. Happens once." },
    { t:"Warm up the LLM",
      r:"main.py:216",
      h:"A single round-trip to the model (<em>“reply OK”</em>) fails fast if your key or provider is wrong — before any container or agent is created." },
    { t:"Scan engine starts",
      r:"runner.py:104",
      h:"<em>run_strix_scan</em> begins and creates the <em>AgentCoordinator</em> — the single brain that will track every agent, route messages, and snapshot state for resume." },
    { t:"Docker container boots",
      r:"docker_client.py:140",
      h:"<em>docker.from_env()</em> → <em>containers.create()</em> builds one privileged container (NET_ADMIN/NET_RAW for raw-socket scans, host-gateway to reach your Mac), kept alive by <code>tail -f /dev/null</code>. <em>session.start()</em> copies the target into <code>/workspace</code>." },
    { t:"Caido proxy comes up",
      r:"session_manager.py:120",
      h:"Inside the container, the <em>Caido proxy</em> starts and <code>http_proxy</code>/<code>https_proxy</code> are injected — so every HTTP request any agent makes is captured automatically." },
    { t:"Root agent begins",
      r:"runner.py:173 · 270",
      h:"The root <em>strix</em> agent is built (system prompt + tools) and registered. Its <em>run_agent_loop</em> starts and it takes its first turn — a call to the LLM." },
    { t:"Root forks a swarm",
      r:"execution.py:574",
      h:"The root calls <code>create_agent</code> twice. Each becomes <em>asyncio.create_task(…)</em> — an independent, non-awaited task. Two specialist children pop into the graph, running in parallel." },
    { t:"Root parks and waits",
      r:"agents_graph/tools.py:308",
      h:"With children working, the root calls <code>wait_for_message</code> and <em>parks</em>. Because it’s now awaiting, the single event loop is free to run the two children concurrently." },
    { t:"Children run real tools",
      r:"factory.py:405",
      h:"Each child’s <code>exec_command</code> becomes a <em>docker exec</em> into the shared container: <code>nmap</code>, <code>ffuf</code>, <code>sqlmap</code>. Their HTTP traffic auto-routes through Caido." },
    { t:"A vulnerability is found",
      r:"reporting/tool.py",
      h:"The API Specialist confirms an <em>IDOR</em>, validates a PoC, and files <code>create_vulnerability_report</code>. The finding is written to the scan report and surfaced live." },
    { t:"Child reports back",
      r:"agents.py:123",
      h:"The child calls <code>agent_finish</code>: its report is <em>appended into the root’s conversation</em> and <em>wake.set()</em> fires — waking the parked root. The child is now completed." },
    { t:"Root writes the report",
      r:"factory.py:379",
      h:"With both children done, the root synthesizes an executive summary and calls <code>finish_scan</code> — the lifecycle tool that ends its loop and the scan." },
    { t:"Teardown",
      r:"session_manager.py:157",
      h:"<em>client.delete()</em> kills and removes the container — everything the AI did vanishes with it. Results persist on your Mac in <code>strix_runs/&lt;run&gt;/</code>." }
  ];
  var N = STEPS.length;

  // Per-step LLM decision (only steps where the model is actually reasoning).
  // { text, active }. Steps not listed = no model call this step.
  var DECISIONS = {
    2:  "handshake · reply “OK”",
    6:  "plan strategy → split into 2 specialists",
    9:  "choose tools → nmap, ffuf, sqlmap",
    10: "judge: IDOR is real → file a report",
    12: "synthesize findings → finish_scan"
  };

  // ---- timing ----
  var speed = 1;
  var DWELL = 2600, FLIGHT = 720;
  var timer = null, playing = false;
  var cur = -1;

  // ---- build track ----
  var track = $("#track");
  for (var i=0;i<N;i++){
    var b = document.createElement("button");
    b.className = "tick"; b.setAttribute("data-on","0");
    b.setAttribute("aria-label","Go to step "+(i+1));
    (function(idx){ b.addEventListener("click", function(){ pause(); goTo(idx, false); }); })(i);
    track.appendChild(b);
  }
  var ticks = Array.prototype.slice.call(track.children);

  // ---- element refs ----
  var el = {
    zHost:$("#z-host"), zDocker:$("#z-docker"), zLLM:$("#z-llm"),
    cliCmd:$("#cliCmd"), caret:$("#caret"),
    coord:$("#coord"), coordPill:$("#coordPill"),
    root:$("#rootNode"), childA:$("#childA"), childB:$("#childB"),
    caps:$("#caps"), tools:$("#tools"), vuln:$("#vuln"),
    dockerStatus:$("#dockerStatus"),
    brain:$("#brain"), results:$("#results"),
    decision:$("#decision"), decisionVal:$("#decisionVal"),
    proxy:document.querySelector('.chip.proxy'),
    stepno:$("#stepno"), stepTitle:$("#stepTitle"), ref:$("#ref"), narration:$("#narration")
  };

  function toolChip(name){ return document.querySelector('.chip[data-tool="'+name+'"]'); }

  // ---- deterministic world state at step n (0-based) ----
  function applyState(n){
    // n<0 => pristine (pre-step-1)
    // CLI text
    el.cliCmd.textContent = n>=0 ? CMD : "";
    el.caret.style.opacity = (n>=0 && n<1) ? "1" : "0";

    // coordinator
    var coordOn = n>=3;
    el.coord.setAttribute("data-live", coordOn?"1":"0");
    el.coordPill.textContent = coordOn ? (n>=13 ? "done" : "tracking") : "idle";

    // root node
    el.root.style.opacity = n>=6 ? "1" : "0";
    var rootState = "off";
    if (n>=6) rootState = "running";
    if (n>=8 && n<=11) rootState = "waiting";
    if (n>=12) rootState = "running";
    if (n>=13) rootState = "done";
    el.root.setAttribute("data-state", rootState);

    // children
    var kidsShown = n>=7 ? "1":"0";
    el.childA.setAttribute("data-shown", kidsShown);
    el.childB.setAttribute("data-shown", kidsShown);
    var kidState = "running";
    if (n>=11) kidState = "done";
    el.childA.setAttribute("data-state", n>=7?kidState:"running");
    el.childB.setAttribute("data-state", n>=7?kidState:"running");

    // docker zone: boot at step index 4, run 5..12, dead 13+
    var dphase = "off";
    if (n===4) dphase="boot";
    else if (n>=5 && n<=12) dphase="run";
    else if (n>=13) dphase="dead";
    el.zDocker.setAttribute("data-phase", dphase);
    el.zDocker.setAttribute("data-live", (dphase==="run"||dphase==="boot")?"1":"0");
    el.dockerStatus.textContent =
      dphase==="off" ? "container: not started" :
      dphase==="boot" ? "container: booting…" :
      dphase==="run" ? "container: running · /workspace ready" :
      "container: destroyed";

    // caido proxy chip
    el.proxy.setAttribute("data-on", (n>=5 && n<=12) ? "1":"0");

    // llm live
    el.zLLM.setAttribute("data-live", n>=2 ? "1":"0");

    // vuln
    el.vuln.setAttribute("data-shown", n>=10 ? "1":"0");

    // results on host/llm column
    el.results.setAttribute("data-shown", n>=13 ? "1":"0");

    // LLM live decision readout
    var dec = DECISIONS[n];
    if (dec){
      el.decision.setAttribute("data-active","1");
      el.decisionVal.textContent = dec;
    } else {
      el.decision.setAttribute("data-active","0");
      el.decisionVal.textContent = n<2 ? "awaiting first turn"
                                 : n>=13 ? "scan complete"
                                 : "idle · no model call this step";
    }

    // clear transient fire states when scrubbing
    Array.prototype.forEach.call(document.querySelectorAll('.chip'), function(c){
      if (c.classList.contains('proxy')) return;
      c.setAttribute("data-fire","0");
    });
    el.brain.setAttribute("data-think","0");

    // narration + track
    var s = STEPS[Math.max(0,n)];
    el.stepno.textContent = String(Math.max(0,n)+1).padStart(2,"0") + " / " + N;
    el.stepTitle.textContent = s.t;
    el.ref.innerHTML = "<b>"+s.r.split(" ")[0]+"</b>" + s.r.slice(s.r.split(" ")[0].length);
    el.narration.innerHTML = s.h;
    ticks.forEach(function(tk,idx){
      tk.setAttribute("data-on", idx<=n ? "1":"0");
      tk.setAttribute("data-cur", idx===n ? "1":"0");
    });
  }

  // ---- token flight ----
  function centerOf(node){
    var r = node.getBoundingClientRect(), s = stage.getBoundingClientRect();
    return { x: r.left - s.left + r.width/2, y: r.top - s.top + r.height/2 };
  }
  function flash(node){ if(!node) return; node.classList.remove("pulse"); void node.offsetWidth; node.classList.add("pulse"); }

  function fly(from, to, label, kind, delay){
    if(!from || !to) return;
    if(reduce){ setTimeout(function(){ flash(to); }, delay||0); return; }
    setTimeout(function(){
      var a = centerOf(from), b = centerOf(to);
      var t = document.createElement("div");
      t.className = "token token--"+kind; t.textContent = label;
      t.style.transitionDuration = (FLIGHT/speed)+"ms, .3s";
      t.style.transform = "translate(calc("+a.x+"px - 50%), calc("+a.y+"px - 50%))";
      stage.appendChild(t);
      // force reflow then move
      void t.offsetWidth;
      requestAnimationFrame(function(){
        t.style.opacity = "1";
        t.style.transform = "translate(calc("+b.x+"px - 50%), calc("+b.y+"px - 50%))";
      });
      var d = FLIGHT/speed;
      setTimeout(function(){ t.style.opacity="0"; }, d-140);
      setTimeout(function(){ t.remove(); flash(to); }, d+40);
    }, delay||0);
  }
  function think(ms){ if(reduce) return; el.brain.setAttribute("data-think","1"); setTimeout(function(){ el.brain.setAttribute("data-think","0"); }, ms/speed); }
  function fireTool(name, delay){
    var c = toolChip(name); if(!c) return;
    setTimeout(function(){ c.setAttribute("data-fire","1"); setTimeout(function(){ c.setAttribute("data-fire","0"); }, 900/speed); }, delay||0);
  }

  // ---- one-shot effects when entering step n live (forward) ----
  function fx(n){
    switch(n){
      case 1: fly(el.cli || el.cliCmd, el.zDocker, "docker pull", "cmd", 120); break;
      case 2: think(1200); fly(el.zHost, el.zLLM, "warm-up", "llm", 100); fly(el.zLLM, el.zHost, "200 OK", "msg", FLIGHT/speed+220); break;
      case 3: flash(el.coord); break;
      case 4: fly(el.zHost, el.zDocker, "docker create", "cmd", 120); break;
      case 5: el.proxy.setAttribute("data-on","1"); flash(el.proxy); break;
      case 6: think(1100); fly(el.root, el.zLLM, "turn 1", "llm", 200); break;
      case 7: fly(el.root, el.childA, "create_agent", "spawn", 120); fly(el.root, el.childB, "create_agent", "spawn", 320); break;
      case 8: flash(el.root); break;
      case 9:
        fireTool("nmap", 150); fireTool("ffuf", 380); fireTool("sqlmap", 620);
        fly(el.childA, el.zDocker, "nmap -sV", "cmd", 120);
        fly(el.childB, el.zDocker, "ffuf /api", "cmd", 360);
        break;
      case 10: fly(el.childB, el.zDocker, "GET /api/orders/2", "danger", 100); break;
      case 11:
        fly(el.childB, el.root, "report", "msg", 120);
        fly(el.childA, el.root, "report", "msg", 360);
        break;
      case 12: think(1100); fly(el.root, el.zHost, "finish_scan", "msg", 220); break;
      case 13: fly(el.zDocker, el.zHost, "results saved", "msg", 120); break;
    }
  }

  // ---- navigation ----
  var lastCliTypeToken = 0;
  function typeCli(){
    if(reduce){ el.cliCmd.textContent = CMD; return; }
    el.cliCmd.textContent = "";
    var i=0, my = ++lastCliTypeToken;
    (function tick(){
      if(my!==lastCliTypeToken) return;
      el.cliCmd.textContent = CMD.slice(0,i);
      if(i++ < CMD.length) setTimeout(tick, 26/speed);
    })();
  }

  function goTo(n, live){
    n = Math.max(0, Math.min(N-1, n));
    var forwardOne = live && n === cur+1;
    cur = n;
    applyState(n);
    if(n===0 && live) typeCli();
    if(forwardOne) fx(n);
  }

  function next(live){
    if(cur >= N-1){ pause(); return; }
    goTo(cur+1, live!==false);
  }

  function play(){
    if(cur >= N-1){ goTo(0, false); }
    playing = true; setPlayBtn();
    schedule();
  }
  function schedule(){
    clearTimeout(timer);
    if(!playing) return;
    var wait = (cur<0?400:DWELL)/speed;
    timer = setTimeout(function(){
      if(cur >= N-1){ pause(); return; }
      next(true);
      schedule();
    }, wait);
  }
  function pause(){ playing=false; clearTimeout(timer); setPlayBtn(); }
  function setPlayBtn(){ $("#playBtn").innerHTML = playing ? "⏸ Pause" : (cur>=N-1 ? "↺ Replay" : "▶ Play"); }

  // ---- controls ----
  $("#playBtn").addEventListener("click", function(){
    if(playing) pause();
    else if(cur>=N-1){ goTo(0,false); play(); }
    else play();
  });
  $("#stepBtn").addEventListener("click", function(){ pause(); next(true); });
  $("#restartBtn").addEventListener("click", function(){ pause(); cur=-1; goTo(0,true); });

  Array.prototype.forEach.call(document.querySelectorAll(".spd button"), function(b){
    b.addEventListener("click", function(){
      speed = parseFloat(b.getAttribute("data-spd"));
      document.querySelectorAll(".spd button").forEach(function(x){ x.setAttribute("aria-pressed","false"); });
      b.setAttribute("aria-pressed","true");
      if(playing) schedule();
    });
  });

  // keyboard: space=play/pause, arrows=step
  document.addEventListener("keydown", function(e){
    if(e.target.tagName==="BUTTON" && e.key!==" ") return;
    if(e.key===" "){ e.preventDefault(); $("#playBtn").click(); }
    else if(e.key==="ArrowRight"){ e.preventDefault(); pause(); next(true); }
    else if(e.key==="ArrowLeft"){ e.preventDefault(); pause(); goTo(Math.max(0,cur-1), false); }
  });

  // theme toggle
  var tbtn = $("#themeBtn"), tlbl = $("#themeLbl");
  function sysDark(){ return window.matchMedia("(prefers-color-scheme: dark)").matches; }
  var forced = null;
  function applyTheme(){
    var dark = forced===null ? sysDark() : forced==="dark";
    if(forced===null){ document.documentElement.removeAttribute("data-theme"); }
    else { document.documentElement.setAttribute("data-theme", forced); }
    tlbl.textContent = forced===null ? "Auto" : (dark?"Dark":"Light");
  }
  tbtn.addEventListener("click", function(){
    var d = forced===null ? sysDark() : forced==="dark";
    forced = d ? "light" : "dark";
    applyTheme();
  });
  applyTheme();

  // ---- start ----
  goTo(0, false);
  // autoplay "live action"
  setTimeout(function(){ cur=-1; goTo(0,true); play(); }, 500);
})();
</script>
